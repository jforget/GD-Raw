# -*- encoding: utf-8; indent-tabs-mode: nil -*-
#
# Testing the generation of graphic data into a blob instead of into a file
#
# Tested formats: BMP (with and without RLE compression), GIF, JPEG, PNG
# Untested formats: GD, TIFF, WebP
# Unimplemented formats: GD2, HEIF, WBMP
#
use Test;
use GD::Raw;
use MIME::Base64;
use NativeHelpers::Blob;

use lib $*PROGRAM.parent;
use gdtest;

plan 1;

my $width  = 10;
my $height = 10;
my $im     = gdImageCreate($width, $height);
LEAVE gdImageDestroy($im) if $im;
my $white  = gdImageColorAllocate($im, 255, 255, 255);
my $red    = gdImageColorAllocate($im, 255,   0,   0);
my $blue   = gdImageColorAllocate($im,   0,   0, 255);

gdImageLine($im, 0, 0, 9, 9, $red);
gdImageLine($im, 9, 0, 0, 9, $blue);

my int32 $size;
my $ptr  = gdImagePngPtr($im, $size);
my $blob = blob-from-pointer($ptr, elems => $size, type => Blob[int8]);
my $png  =  MIME::Base64.encode($blob);
gdFree($ptr);

$ptr     = gdImagePngPtrEx($im, $size, 0);
$blob    = blob-from-pointer($ptr, elems => $size, type => Blob[int8]);
my $png0 =  MIME::Base64.encode($blob);
gdFree($ptr);

$ptr     = gdImagePngPtrEx($im, $size, 9);
$blob    = blob-from-pointer($ptr, elems => $size, type => Blob[int8]);
my $png9 =  MIME::Base64.encode($blob);
gdFree($ptr);

$ptr     = gdImageJpegPtr($im, $size, -1);
$blob    = blob-from-pointer($ptr, elems => $size, type => Blob[int8]);
my $jpeg =  MIME::Base64.encode($blob);
gdFree($ptr);

$ptr     = gdImageGifPtr($im, $size);
$blob    = blob-from-pointer($ptr, elems => $size, type => Blob[int8]);
my $gif  =  MIME::Base64.encode($blob);
gdFree($ptr);

$ptr     = gdImageBmpPtr($im, $size, 0);
$blob    = blob-from-pointer($ptr, elems => $size, type => Blob[int8]);
my $bmp  =  MIME::Base64.encode($blob);
gdFree($ptr);

$ptr     = gdImageBmpPtr($im, $size, 1);
$blob    = blob-from-pointer($ptr, elems => $size, type => Blob[int8]);
my $bmp1 =  MIME::Base64.encode($blob);
gdFree($ptr);

my $test = qq :to/EOF/;
<html>
<head><title>Example of graphic file generated by GD</title></head>
<body>
<h1>Embedded PNG data</h1>
<img src='data:image/png;base64,$png'>
<h1>Embedded PNG data (compression 0)</h1>
<img src='data:image/png;base64,$png0'>
<h1>Embedded PNG data (compression 9)</h1>
<img src='data:image/png;base64,$png9'>
<h1>Embedded JPEG data</h1>
<img src='data:image/png;base64,$jpeg'>
<h1>Embedded GIF data</h1>
<img src='data:image/png;base64,$gif'>
<h1>Embedded BMP data</h1>
<img src='data:image/png;base64,$bmp'>
<h1>Embedded BMP data (RLE)</h1>
<img src='data:image/png;base64,$bmp1'>
</body>
</html>
EOF
gdFree($ptr);
my $ref = $*PROGRAM.sibling("ported-gdimagepngptr/gd-image-xxx-ptr.html").IO.slurp;
ok $test eq $ref;

# vim: expandtab shiftwidth=4
