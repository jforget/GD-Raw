# -*- encoding: utf-8; indent-tabs-mode: nil -*-
use Test;
use GD::Raw;
use MIME::Base64;
use NativeHelpers::Blob;

use lib $*PROGRAM.parent;
use gdtest;

plan 1;

my $width  = 120;
my $height =  50;
my $im     = gdImageCreate($width, $height);
LEAVE gdImageDestroy($im) if $im;
my $white  = gdImageColorAllocate($im, 255, 255, 255);
my $black  = gdImageColorAllocate($im,   0,   0,   0);
my $red    = gdImageColorAllocate($im, 255,   0,   0);
my $blue   = gdImageColorAllocate($im,   0,   0, 255);

gdImageLine($im, 10, 10, 100, 10, $red);
gdImageLine($im, 10, 20, 100, 20, $blue);
gdImageLine($im, 10, 30, 100, 40, $black);

my int32 $size;
my $ptr  = gdImagePngPtr($im, $size);
my $blob = blob-from-pointer($ptr, elems => $size, type => Blob[int8]);
my $png  =  MIME::Base64.encode($blob);
my $test = qq :to/EOF/;
<html>
<head><title>Example of graphic file generated by GD</title></head>
<body>
<h1>External PNG file</h1>
<img src='00-basic-lines.png'>
<h1>Embedded PNG data</h1>
<img src='data:image/png;base64,$png'>
</body>
</html>
EOF
gdFree($ptr);
my $ref = $*PROGRAM.sibling("ported-gdimagepngptr/00-basic-lines.html").IO.slurp;
ok $test eq $ref;

# vim: expandtab shiftwidth=4
